# Dependencies
node_modules/

# The local AI runtime and its models. Gigabytes of weights do not belong in
# git — `scripts/install-ai.ps1` fetches them on a machine that needs them.
#
# ANCHORED to the repository root. Unanchored, `ai/` matches a directory of
# that name at ANY depth, which silently swallowed js/ai/ — the DM narrator,
# the referee, the prompt builder, the offline DM, the backstory generator, the
# model backend, the schema and the player agent. Eight source files, the whole
# AI layer, never committed: a clone of this repository could not run the game
# at all, and nothing said so because ignored files are not reported as
# untracked.
/ai/
*.gguf
*.bin
*.safetensors

# Saved games and transcripts a session produced. The game writes here; the
# repository is not where anyone's campaign should live.
exports/*.json
exports/*.md

# Playtest and server logs
logs/
_playtest*.log
_s.log
_s.err
_shen.log
*.log

# Test screenshots, regenerated on every browser run
tests/shot-*.png

# The unpacked source material the campaign was reconstructed from
_source/

# Python bytecode from the one-off SRD extraction scripts
__pycache__/
*.pyc

# UI screenshots written by tests/shots.js, regenerated on demand
shots/
shots[0-9]/

# Documents from other work that share this folder. They are not part of the
# game, and one of them being locked by Word has already broken a restore.
*.docx
*.doc
